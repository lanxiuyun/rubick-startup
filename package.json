{
  "name": "rubick-startup",
  "pluginName": "启动收藏",
  "description": "Windows 运行框式输入、执行、记录历史并支持收藏；关键词：运行、启动、start、fav",
  "version": "26.10.13",
  "main": "public/index.html",
  "logo": "data:image/svg+xml;base64,",
  "pluginType": "ui",
  "features": [
    {
      "code": "index",
      "explain": "输入路径或命令，回车运行并检索历史",
      "cmds": ["运行", "启动", "start", "fav"]
    }
  ],
  "private": true,
  "scripts": {
    "serve": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "deps": "npm install",
    "audit": "npm audit",
    "install:rubick": "node tools/install.js",
    "check:rubick": "node tools/install.js --check",
    "uninstall:rubick": "node tools/install.js --uninstall",
    "test": "npm run build && node tests/run-all.js",
    "test:visual": "node tests/visual.e2e.js"
  },
  "dependencies": {
    "rc-virtual-list": "^3.19.2",
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
